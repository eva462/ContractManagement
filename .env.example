# ─── 数据库（本地 Docker）────────────────────────────────────────────
# 用 127.0.0.1 而不是 localhost：Windows 上 localhost 会先解析到 ::1，
# 而 Docker 发布的 IPv6 端口在这台机器上连不通，Prisma 会直接超时。
DATABASE_URL="postgresql://contract:contract@127.0.0.1:5433/contract?schema=public"
# 可选：覆盖 compose 使用的镜像。默认 postgres:16-alpine
# POSTGRES_IMAGE=pgvector/pgvector:pg16

# ─── 后端 ──────────────────────────────────────────────────────────
# 端口刻意避开常见的 3000/5173，免得和机器上其他项目抢
PORT=3100
CORS_ORIGIN=http://localhost:5273

# 认证（本地开发密钥，切勿用于任何对外环境）
JWT_SECRET=dev-only-secret-please-change
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=30d

# 附件存储（当前实现：本地磁盘。见 apps/server/src/storage/provider.ts）
STORAGE_DRIVER=local
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=50
MAX_ATTACHMENTS_PER_CONTRACT=20

# 合同可见范围：ALL = 全员可见全部；OWN = 非管理员只看自己经办的
CONTRACT_VISIBILITY=ALL

# ─── 内容识别 ──────────────────────────────────────────────────────
#
# 一个 key 都不填 → 识别功能整体关闭，新建页不显示识别入口，手工录入不受影响。
#
# 配了 key 之后，用于识别的合同原件会被上传到对应厂商的服务器。
# 不希望出网的合同，直接手工录入即可（识别是可选入口，不是必经步骤）。
#
# 下面各模型名只是「写这段代码时的当前型号」，各家改名换代很快。
# 以你控制台里实际可用的型号为准，改这里就行，不用动代码。

# 用哪家：deepseek / qwen。留空则自动挑一个配了 key 的。
EXTRACTION_PROVIDER=
EXTRACTION_TIMEOUT_MS=180000

# DeepSeek
DEEPSEEK_API_KEY=
# 走代理或镜像时改这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# 通义千问（阿里云百炼，OpenAI 兼容模式）
# baseUrl 各地域不同，新版控制台还会带上 WorkspaceId，以控制台显示的为准
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
# 百炼兼容模式对 response_format 的支持没有明确文档，默认只靠提示词约束。
# 确认支持后可以打开，输出会更稳定。
QWEN_JSON_MODE=false

# ─── 前端 ──────────────────────────────────────────────────────────
WEB_PORT=5273
VITE_API_BASE_URL=http://localhost:3100
