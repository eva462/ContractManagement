// 枚举值必须与 packages/shared/src/enums.ts 逐字一致。
// 改任何一边都要同步另一边，否则运行时才会炸。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

// 「已到期」不在这里，由 expiryDate 实时派生，不落库。
//
// 注意 PENDING_FILING「待归档」和 CLOSED「已完结」是两个相反的概念：
// 前者是纸件入档 + 扫描件上传，是生效前的关口；后者是合同完结封存。
// 详见 docs/design/03-审批流程与设置模块.md
enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING_SIGNING
  PENDING_FILING
  ACTIVE
  TERMINATED
  CLOSED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum AmountType {
  TAX_INCLUDED
  TAX_EXCLUDED
  NO_AMOUNT
}

enum Currency {
  CNY
  USD
  EUR
  HKD
}

enum AttachmentType {
  ORIGINAL
  SUPPLEMENT
  ANNEX
  OTHER
}

enum AuditEntityType {
  CONTRACT
  ATTACHMENT
  USER
  DICT
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DELETE
  UPLOAD
  DOWNLOAD
  LOGIN
  LOGIN_FAILED
  EXTRACT
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedContracts    Contract[]           @relation("ContractOwner")
  createdContracts  Contract[]           @relation("ContractCreatedBy")
  updatedContracts  Contract[]           @relation("ContractUpdatedBy")
  uploads           ContractAttachment[]
  auditLogs         AuditLog[]
  approvalsAssigned ContractApproval[]   @relation("ApprovalApprover")
  approvalsDecided  ContractApproval[]   @relation("ApprovalDecidedBy")
  refreshTokens     RefreshToken[]

  @@map("users")
}

// refresh token 只存哈希，库被看到也不能拿来换 access token
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Contract {
  id String @id @default(cuid())

  // 草稿允许没有编号；Postgres 的唯一索引允许多个 NULL，正好符合需要
  contractNo String? @unique

  title               String
  /// 引用 dict_items 里 dictCode=CONTRACT_TYPE 的 itemCode。
  /// 刻意不是数据库枚举 —— 加一个合同类型不该需要改代码重新部署。
  contractType        String?
  counterpartyName    String?
  counterpartyContact String?

  amountType   AmountType?
  amount       Decimal?    @db.Decimal(18, 2) // 绝不用浮点存钱
  currency     Currency    @default(CNY)
  paymentTerms String?

  signDate      DateTime? @db.Date
  effectiveDate DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  isPerpetual   Boolean   @default(false)

  ownerId String?
  status  ContractStatus @default(DRAFT)

  // 完结前的状态。解除完结时回到这里，而不是笼统地回到 ACTIVE。
  closedFrom ContractStatus?

  // 线下纸面签署完成的日期，登记签署时填
  signedDate DateTime? @db.Date

  originalLocation  String?
  remark            String?
  terminatedAt      DateTime? @db.Date
  terminationReason String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // 软删除。查询一律带 deletedAt: null

  owner       User?                @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?                @relation("ContractUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  attachments ContractAttachment[]
  approvals   ContractApproval[]

  @@index([status])
  @@index([ownerId])
  @@index([contractType])
  @@index([signDate])
  @@index([expiryDate])
  @@index([deletedAt])
  // 中文关键词搜索用 ILIKE '%x%'，走不了 B-tree；trgm 的 GIN 索引可以。
  // 必须在这里声明，否则 prisma migrate 会把手写的索引当成 drift 再 DROP 掉。
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([contractNo(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([counterpartyName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("contracts")
}

model ContractAttachment {
  id         String @id @default(cuid())
  contractId String

  fileName String // 原始文件名，下载时用它，用户看到的是自己传的中文名
  fileSize Int
  mimeType String
  sha256   String // 内容哈希：同一文件重复上传不重复占磁盘，也可用来校验损坏

  // 存储层的键。当前是本地磁盘相对路径，换成 S3 时这里放对象 key，业务代码不用改。
  storageKey String

  attachmentType AttachmentType @default(ANNEX)
  uploadedById   String?
  uploadedAt     DateTime       @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([sha256])
  @@map("contract_attachments")
}

// 只增不改不删。应用层不提供任何 UPDATE/DELETE 接口，
// 迁移里另有数据库触发器兜底（见 migrations/.../migration.sql）。
model AuditLog {
  id String @id @default(cuid())

  entityType AuditEntityType
  entityId   String
  action     AuditAction

  userId   String?
  userName String // 写入时的快照，改名或停用账号后历史记录依然可读

  summary String // 人话摘要，时间线直接显示
  changes Json? // 字段级 before/after，只含真正变化的字段

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// 审批节点。当前是单级审核（提交时只生成一条 seq=1），但表结构按多级设计，
/// 以后要升到两级或按金额分级，只改「生成审批节点」那个函数，不用动这张表。
model ContractApproval {
  id         String @id @default(cuid())
  contractId String
  /// 第几级，从 1 开始。单级审核恒为 1。
  seq        Int

  /// 指定审批人。留空 = 任意 MANAGER 及以上都可以审（当前单级审核就是这样，
  /// 这样不用先做审批人配置界面就能跑起来）。
  approverId String?

  decision    ApprovalDecision @default(PENDING)
  /// 驳回时必填
  comment     String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approver  User?    @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  decidedBy User?    @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([contractId, seq])
  @@index([decision])
  @@map("contract_approvals")
}

/// 数据字典。把「合同类型」这类原本写死在代码里的枚举挪出来，
/// 让管理员在设置里自己维护，不用改代码重新部署。
///
/// 被引用过的字典项**不允许删除，只能停用**（isActive=false）——
/// 否则历史合同的类型会变成空。停用后新建时选不到，老合同照常显示。
model DictItem {
  id        String @id @default(cuid())
  /// 字典分组：CONTRACT_TYPE / OUR_ENTITY / DEPARTMENT
  dictCode  String
  /// 存进业务表的值，建库后不应再改
  itemCode  String
  /// 界面上显示的中文名，随时可改
  itemLabel String

  /// 合同类型专用：合同编号前缀（采购 → CG）。其他分组留空。
  /// 编号格式 {prefix}-{年份}-{4位流水}，所以改这个会影响新建合同的编号。
  prefix String?

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dictCode, itemCode])
  @@index([dictCode, isActive, sortOrder])
  @@map("dict_items")
}
