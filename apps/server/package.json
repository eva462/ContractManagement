{
  "name": "@contract/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "test:extraction": "node scripts/extraction-test.mjs",
    "test:normalize": "tsx scripts/normalize-test.mjs",
    "compare": "tsx scripts/compare-extractors.mjs",
    "verify:live": "tsx scripts/verify-extraction-live.mjs",
    "sample": "node scripts/make-sample-contract.mjs",
    "bench:parse": "tsx scripts/bench-parse.mjs",
    "demo:start": "tsx scripts/demo-tunnel.mjs start",
    "demo:end": "tsx scripts/demo-tunnel.mjs end",
    "postinstall": "prisma generate",
    "test:redaction": "tsx scripts/redaction-test.mjs",
    "test:review": "tsx scripts/review-test.mjs",
    "show:redaction": "tsx scripts/show-redaction.mjs"
  },
  "dependencies": {
    "@contract/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "mupdf": "^1.28.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
